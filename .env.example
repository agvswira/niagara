# Salin jadi .env lalu isi. Tanpa GEMINI_API_KEY, Niagara jalan di mode offline (parser aturan).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# LLM_PROVIDER=heuristic   # paksa mode offline walau ada API key

# Default: SQLite lokal. Untuk Postgres/Supabase, pasang psycopg[binary] lalu pakai: postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=sqlite:///niagara.db

# Login dashboard. Akun demo: admin (admin order), ar (staf AR), supervisor. Semua memakai kata sandi ini.
# Ganti sebelum deploy publik. Kata sandi hanya dipakai saat akun dibuat pertama kali.
NIAGARA_DEMO_PASSWORD=niagara-demo
# Kunci penanda tangan cookie sesi. Kosong = dibuat acak dan disimpan di database.
NIAGARA_SECRET=

# Opsional: bot Telegram sebagai kanal nyata. Pelanggan ketik "/start <id_pelanggan>" untuk menautkan chat.
TELEGRAM_BOT_TOKEN=
# Isi juga di setWebhook (secret_token) agar webhook hanya menerima panggilan dari Telegram.
TELEGRAM_WEBHOOK_SECRET=
COMPANY_NAME=CV Maju Sejahtera Distribusi

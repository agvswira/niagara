# Salin jadi .env lalu isi. Tanpa API key apa pun, Niagara jalan di mode offline (parser aturan).

# Urutan penyedia yang dicoba. Yang tidak punya key dilewati. Penyedia yang kena limit dijeda sementara
# dan pesan berikutnya langsung ke penyedia selanjutnya; kalau semua gagal, dipakai parser offline.
LLM_CHAIN=compat,gemini
# LLM_PROVIDER=heuristic   # paksa mode offline walau ada API key
LLM_TIMEOUT_SECONDS=30

# Penyedia berformat OpenAI: Groq (bawaan di bawah), OpenRouter, OpenAI, Together, atau Ollama lokal.
# Cek nama model yang aktif di konsol penyedia; daftar model sering berubah.
OPENAI_COMPAT_NAME=groq
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
# Hanya untuk model reasoning seperti gpt-oss: low = lebih cepat dan hemat token. Kosongkan untuk model lain.
OPENAI_COMPAT_REASONING_EFFORT=low
# Opsional: model yang bisa membaca gambar (foto nota, bukti transfer) dan model transkripsi pesan suara.
# Kosong = foto dan suara langsung diteruskan ke penyedia berikutnya di rantai (misalnya Gemini).
OPENAI_COMPAT_VISION_MODEL=
OPENAI_COMPAT_AUDIO_MODEL=
# Contoh OpenRouter: OPENAI_COMPAT_NAME=openrouter, OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# Contoh Ollama lokal (tanpa key): OPENAI_COMPAT_NAME=ollama, OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Default: SQLite lokal. Untuk Postgres/Supabase, pasang psycopg[binary] lalu pakai: postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=sqlite:///niagara.db

# Login dashboard. Akun demo: admin (admin order), ar (staf AR), supervisor. Semua memakai kata sandi ini.
# Ganti sebelum deploy publik. Kata sandi hanya dipakai saat akun dibuat pertama kali.
NIAGARA_DEMO_PASSWORD=niagara-demo
# 1 = buat juga akun admin (admin order) dan ar (staf AR). Kosong = hanya supervisor.
NIAGARA_ROLE_ACCOUNTS=
# Kunci penanda tangan cookie sesi. Kosong = dibuat acak dan disimpan di database.
NIAGARA_SECRET=

COMPANY_NAME=CV Maju Sejahtera Distribusi
# Rekening tujuan yang disebut di pesan penagihan dan pesan order ditahan. Kosong = "rekening simulasi" di demo.
PAYMENT_ACCOUNT=
